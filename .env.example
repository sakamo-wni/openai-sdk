# OpenAI API Key
OPENAI_API_KEY=sk-your-api-key-here

# AWS Configuration
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL_ID=C0123456789

# GitHub Configuration
GITHUB_TOKEN=ghp_your-github-token
GITHUB_OWNER=your-org-or-username
GITHUB_REPO=your-repo-name

# Service Configuration (JSON format)
# Maps service names to their CloudWatch log groups
SERVICE_LOG_GROUPS={"api-service": {"dev": "/aws/lambda/api-service-dev", "prod": "/aws/lambda/api-service-prod"}, "web-app": {"dev": "/aws/ecs/web-app-dev", "prod": "/aws/ecs/web-app-prod"}}

# Default environment
DEFAULT_ENV=dev
